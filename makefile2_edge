# 指定交叉編譯器 (User's Toolchain)
CXX = /home/mark/arm-fhva12c-linux-uclibcgnueabihf-b5.3/arm-fhva12c-linux-uclibcgnueabihf-b5/bin/arm-fhva12c-linux-uclibcgnueabihf-g++
AR = /home/mark/arm-fhva12c-linux-uclibcgnueabihf-b5.3/arm-fhva12c-linux-uclibcgnueabihf-b5/bin/arm-fhva12c-linux-uclibcgnueabihf-ar
#CXX = g++

# 設定編譯參數
# 包含 ARM NEON 優化參數
TARGET_ARCH = -mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard

# NPU SDK Path (from ai_ex/Makefile)
SDK_INCLUDE = /home/mark/nn_release/npu_inference/mpp
SDK_LIBRARY = $(SDK_INCLUDE)/linux/va12c/lib

# 通用編譯參數 (+ -fPIC for shared library)
COMMON_FLAGS = -Wall -O3 -fPIC -DNDEBUG
COMMON_FLAGS += -Iinclude -Isrc
COMMON_FLAGS += -I$(SDK_INCLUDE)/include -I$(SDK_INCLUDE)/drv_include

# ARM Specific Flags
ARM_FLAGS = $(TARGET_ARCH)
ARM_FLAGS += -ffunction-sections -mno-unaligned-access -fno-aggressive-loop-optimizations -fstack-protector

# Combine for ARM (Edge)
CXXFLAGS = $(COMMON_FLAGS) $(ARM_FLAGS)

# DEBUG: 除錯符號，供 core dump 配合 cross-gdb 使用（不影響執行效能，只增加檔案大小）
CXXFLAGS += -g

# DEBUG: AddressSanitizer（找出是誰踩壞 main 的堆疊；除錯完移除）
# 板子 RAM 小，執行時務必帶 ASAN_OPTIONS 降低記憶體用量，見下：
#   ASAN_OPTIONS=quarantine_size_mb=4:malloc_context_size=2:redzone=16:detect_leaks=0 ./SDK_DemoCode_v2_save_fall_result_edge app_config_data2.ini
# CXXFLAGS += -fsanitize=address -fno-omit-frame-pointer -static-libasan -static-libstdc++
# NPU Libraries
LDFLAGS_NPU += -Wl,--start-group
LDFLAGS_NPU += $(wildcard $(SDK_LIBRARY)/npu/*.a)
LDFLAGS_NPU += $(SDK_LIBRARY)/libmpi.a
LDFLAGS_NPU += -Wl,--end-group


# 來源檔案
SDK_SRCS = src/HermesII_sdk.cpp \
           src/ai/model_runner.cpp \
           src/ai/face_detector.cpp \
           src/ai/blaze_face_detect_parser.cpp \
           src/fusion/image_fusion.cpp \
           src/fall/fall_detector.cpp \
           src/image_process/image_process.cpp \
           src/event_recorder.cpp

SDK_OBJS = $(SDK_SRCS:.cpp=.o)

# 效能診斷用 SDK_OBJS 變體: 除了 event_recorder 其餘物件檔跟正常編譯共用
# (不受 EVENT_RECORDER_SKIP_RAW_STORAGE 影響, 可以直接重用), event_recorder
# 換成獨立編出的 .norecord.o, 避免跟正常的 event_recorder.o 用同一個檔名
# 互相覆蓋。
SDK_OBJS_NORECORD = $(filter-out src/event_recorder.o,$(SDK_OBJS)) src/event_recorder.norecord.o

# 效能診斷用 SDK_OBJS 變體: event_recorder 帶 -DEVENT_RECORDER_ASYNC_SPOOL=1
# 編譯(把每幀 memcpy 進 mmap ring 的動作搬到背景 spooler 執行緒,讓 SD 卡
# dirty-page 寫入節流卡的是 spooler 而不是餵 frame 的主執行緒;見
# src/event_recorder.cpp 開頭註解)。其餘物件檔跟正常編譯共用。
SDK_OBJS_ASYNC = $(filter-out src/event_recorder.o,$(SDK_OBJS)) src/event_recorder.async.o

# 目標檔案
BUILD_DIR = build
LIB_NAME = libHermesII_sdk.so
LIB_TARGET = $(BUILD_DIR)/$(LIB_NAME)
STATIC_LIB_NAME = libHermesII_sdk.a
STATIC_LIB_TARGET = $(BUILD_DIR)/$(STATIC_LIB_NAME)

# 效能診斷用 .so/.a 變體: 事件錄影編譯時帶 -DEVENT_RECORDER_SKIP_RAW_STORAGE=1
# (見 src/event_recorder.cpp 開頭註解及 SDK_OBJS_NORECORD 定義),完全不碰 SD
# 卡存 raw frame(不建 ring 檔、不存 .raw/.bg raw),只留 .meta.json/
# .analysis.jsonl/event_record.jsonl。跟正常的 libHermesII_sdk.so 檔名不同,
# 可以直接拿去換掉你現有程式原本連結的那顆 .so 來測,不用重新連結你的程式。
LIB_NAME_NORECORD = libHermesII_sdk_norecord.so
LIB_TARGET_NORECORD = $(BUILD_DIR)/$(LIB_NAME_NORECORD)
STATIC_LIB_NAME_NORECORD = libHermesII_sdk_norecord.a
STATIC_LIB_TARGET_NORECORD = $(BUILD_DIR)/$(STATIC_LIB_NAME_NORECORD)

# 效能診斷用 .so/.a 變體: 事件錄影帶 -DEVENT_RECORDER_ASYNC_SPOOL=1(把 raw
# frame 寫進 SD 卡的 memcpy 搬到背景 spooler 執行緒,不卡餵 frame 的主執行緒;
# 見 src/event_recorder.cpp 開頭註解及 SDK_OBJS_ASYNC 定義)。一樣有存 raw,
# 只是寫法不同。跟正常的 libHermesII_sdk.so 檔名不同,可以直接換掉你程式原本
# 連結的那顆 .so 來 A/B 測試,不用改你的程式。
LIB_NAME_ASYNC = libHermesII_sdk_async.so
LIB_TARGET_ASYNC = $(BUILD_DIR)/$(LIB_NAME_ASYNC)
STATIC_LIB_NAME_ASYNC = libHermesII_sdk_async.a
STATIC_LIB_TARGET_ASYNC = $(BUILD_DIR)/$(STATIC_LIB_NAME_ASYNC)

FALL_DEMO_TARGET = fall_demo_edge
FALL_CALLBACK_TARGET = fall_callback_demo_edge
SDK_DEMO_CODE_V1_TARGET = SDK_DemoCode_v1_edge
SDK_DEMO_CODE_V2_TARGET = SDK_DemoCode_v2_edge
SDK_DEMO_CODE_V2_SAVE_FALL_RESULT_TARGET = SDK_DemoCode_v2_save_fall_result_edge
SDK_DEMO_TEST_ACCURACY_TARGET = SDK_DemoCode_v1_test_accuracy
SDK_DEMO_BG_TEST_TARGET = SDK_DemoCode_BG_Test
STREAMING_DEMO_TARGET = streaming_demo_edge
SDK_DEMO_LOOP_TEST_TARGET = SDK_DemoCode_LoopTest_edge

# 編譯 Batch Accuracy Test
FALL_ACCURACY_TEST_TARGET = fall_accuracy_test
SDK_ERRORLOG_VERIFIER_TARGET = sdk_errorlog_verifier_edge
SDK_GRAY_TEST_EDGE_TARGET = sdk_gray_test_edge
EVENT_REPLAY_VERIFY_EDGE_TARGET = event_replay_verify_edge
SDK_GRAY_COUNT_FALLS_EDGE_TARGET = sdk_gray_count_falls_edge
INI_READ_TEST_EDGE_TARGET = ini_read_test_edge

# 效能診斷用: sdk_gray_test_edge 的獨立自我測試變體(不透過 .so/.a,直接連結
# .norecord.o),不需要另外連結 LIB_TARGET_NORECORD 就能快速驗證行為。主要
# 的效能診斷產物是上面的 LIB_TARGET_NORECORD/.so,這個 target 留著方便單獨
# 快速測試用。故意不放進 all,不需要時直接不編即可。
SDK_GRAY_TEST_EDGE_NORECORD_TARGET = sdk_gray_test_edge_norecord

# 預設規則
all: $(LIB_TARGET) $(STATIC_LIB_TARGET) $(FALL_DEMO_TARGET) $(FALL_CALLBACK_TARGET) $(SDK_DEMO_CODE_V1_TARGET) $(SDK_DEMO_CODE_V2_TARGET) $(SDK_DEMO_CODE_V2_SAVE_FALL_RESULT_TARGET) $(SDK_DEMO_TEST_ACCURACY_TARGET) $(STREAMING_DEMO_TARGET) $(FALL_ACCURACY_TEST_TARGET) $(SDK_DEMO_BG_TEST_TARGET) $(SDK_DEMO_LOOP_TEST_TARGET) $(SDK_ERRORLOG_VERIFIER_TARGET) $(SDK_GRAY_TEST_EDGE_TARGET) $(EVENT_REPLAY_VERIFY_EDGE_TARGET) $(SDK_GRAY_COUNT_FALLS_EDGE_TARGET) $(INI_READ_TEST_EDGE_TARGET)

# 建立 build 目錄
$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# 編譯共用函式庫 (.so) - ARM (Edge)
$(LIB_TARGET): $(SDK_OBJS) | $(BUILD_DIR)
	$(CXX) -shared -o $@ $(SDK_OBJS) $(LDFLAGS_NPU) -lpthread

# 編譯靜態函式庫 (.a) - ARM (Edge)
$(STATIC_LIB_TARGET): $(SDK_OBJS) | $(BUILD_DIR)
	$(AR) rcs $@ $(SDK_OBJS)

# 效能診斷用 .so/.a: 事件錄影只寫 json,不存 SD 卡 raw frame(見上面
# LIB_TARGET_NORECORD 註解)。直接把你程式原本連結的 libHermesII_sdk.so
# 換成這份(不用改你的程式、不用重新連結)就能測。
$(LIB_TARGET_NORECORD): $(SDK_OBJS_NORECORD) | $(BUILD_DIR)
	$(CXX) -shared -o $@ $(SDK_OBJS_NORECORD) $(LDFLAGS_NPU) -lpthread

$(STATIC_LIB_TARGET_NORECORD): $(SDK_OBJS_NORECORD) | $(BUILD_DIR)
	$(AR) rcs $@ $(SDK_OBJS_NORECORD)

# 效能診斷用 .so/.a: 事件錄影一樣有存 raw,但寫入 SD 卡的動作搬到背景 spooler
# 執行緒(見上面 LIB_TARGET_ASYNC 註解)。直接把你程式原本連結的
# libHermesII_sdk.so 換成這份就能測,不用改你的程式。
$(LIB_TARGET_ASYNC): $(SDK_OBJS_ASYNC) | $(BUILD_DIR)
	$(CXX) -shared -o $@ $(SDK_OBJS_ASYNC) $(LDFLAGS_NPU) -lpthread

$(STATIC_LIB_TARGET_ASYNC): $(SDK_OBJS_ASYNC) | $(BUILD_DIR)
	$(AR) rcs $@ $(SDK_OBJS_ASYNC)

# 編譯 Fall Demo
$(FALL_DEMO_TARGET): examples/fall_demo.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

# 編譯 Callback Demo
$(FALL_CALLBACK_TARGET): examples/fall_callback_demo.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

# 編譯 SDK Demo Code v1
$(SDK_DEMO_CODE_V1_TARGET): examples/SDK_DemoCode_v1.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

# 編譯 SDK Demo Code v2
$(SDK_DEMO_CODE_V2_TARGET): examples/SDK_DemoCode_v2.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

# 編譯 SDK Demo Code v2 Save Result
$(SDK_DEMO_CODE_V2_SAVE_FALL_RESULT_TARGET): examples/SDK_DemoCode_v2_save_fall_result.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

# 編譯 SDK Demo Code v1 Accuracy Test
$(SDK_DEMO_TEST_ACCURACY_TARGET): examples/SDK_DemoCode_v1_test_accuracy.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

# 編譯 SDK Demo Code BG Test
$(SDK_DEMO_BG_TEST_TARGET): examples/SDK_DemoCode_BG_Test.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

# 編譯 Streaming Demo
$(STREAMING_DEMO_TARGET): examples/streaming_demo.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

$(FALL_ACCURACY_TEST_TARGET): examples/fall_callback_demo_test_accuracy.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

# 編譯 SDK Demo Loop Test
$(SDK_DEMO_LOOP_TEST_TARGET): examples/SDK_DemoCode_LoopTest.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

$(SDK_ERRORLOG_VERIFIER_TARGET): examples/sdk_errorlog_verifier.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

$(SDK_GRAY_TEST_EDGE_TARGET): examples/sdk_gray_test.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

# 效能診斷專用: event_recorder 帶 -DEVENT_RECORDER_SKIP_RAW_STORAGE=1 編譯的物件檔
src/event_recorder.norecord.o: src/event_recorder.cpp
	$(CXX) $(CXXFLAGS) -DEVENT_RECORDER_SKIP_RAW_STORAGE=1 -c $< -o $@

# 效能診斷專用: event_recorder 帶 -DEVENT_RECORDER_ASYNC_SPOOL=1 編譯的物件檔
src/event_recorder.async.o: src/event_recorder.cpp
	$(CXX) $(CXXFLAGS) -DEVENT_RECORDER_ASYNC_SPOOL=1 -c $< -o $@

# 效能診斷專用: sdk_gray_test_edge 的變體, 事件錄影只寫 json, 不寫 SD 卡
# raw frame (見上面 SDK_GRAY_TEST_EDGE_NORECORD_TARGET 註解)。直接連結物件
# 檔, 不建獨立的 .a/.so。
$(SDK_GRAY_TEST_EDGE_NORECORD_TARGET): examples/sdk_gray_test.cpp $(SDK_OBJS_NORECORD)
	$(CXX) $(CXXFLAGS) -o $@ $< $(SDK_OBJS_NORECORD) $(LDFLAGS_NPU) -lpthread -lm -ldl

# 編譯 Event Recording Replay Verifier (讀取 SDK 自身事件錄影, 復驗跌倒判斷)
$(EVENT_REPLAY_VERIFY_EDGE_TARGET): examples/event_replay_verify.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

# 編譯 .gray 跌倒事件計數工具
$(SDK_GRAY_COUNT_FALLS_EDGE_TARGET): examples/sdk_gray_count_falls.cpp $(STATIC_LIB_TARGET)
	$(CXX) $(CXXFLAGS) -o $@ $< $(STATIC_LIB_TARGET) $(LDFLAGS_NPU) -lpthread -lm -ldl

# 編譯 ini_read_test (純檔案讀取隔離測試, 完全不連結 SDK/NPU, 用來排除是否為檔案讀取問題)
$(INI_READ_TEST_EDGE_TARGET): examples/ini_read_test.cpp
	$(CXX) $(CXXFLAGS) -o $@ $<

# 編譯 .o 檔
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# 清除規則
clean:
	rm -f $(SDK_OBJS) $(FALL_DEMO_TARGET) $(FALL_CALLBACK_TARGET) $(SDK_DEMO_CODE_V1_TARGET) $(SDK_DEMO_CODE_V2_TARGET) $(SDK_DEMO_TEST_ACCURACY_TARGET) $(STREAMING_DEMO_TARGET) $(FALL_ACCURACY_TEST_TARGET) $(SDK_DEMO_BG_TEST_TARGET) $(SDK_DEMO_CODE_V2_SAVE_FALL_RESULT_TARGET) $(SDK_DEMO_LOOP_TEST_TARGET) $(SDK_ERRORLOG_VERIFIER_TARGET) $(SDK_GRAY_TEST_EDGE_TARGET) $(EVENT_REPLAY_VERIFY_EDGE_TARGET) $(SDK_GRAY_COUNT_FALLS_EDGE_TARGET) $(INI_READ_TEST_EDGE_TARGET)
	rm -f src/event_recorder.norecord.o $(SDK_GRAY_TEST_EDGE_NORECORD_TARGET)
	rm -f src/event_recorder.async.o
	rm -rf $(BUILD_DIR)
